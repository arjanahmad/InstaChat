# =============================================================================
# INSTAChat Backend Server Configuration
# =============================================================================

# Server Port (Render/Railway/Heroku/Fly.io inject PORT automatically)
PORT=3001
NODE_ENV=production

# Allowed CORS Origins (Comma-separated URLs)
# Example: CORS_ORIGIN=https://instachat07.netlify.app
CORS_ORIGIN=https://instachat07.netlify.app

# JWT / Token Signature Secret (Provide a secure random string in production)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
