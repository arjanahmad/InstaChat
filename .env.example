# =============================================================================
# INSTAChat Client Environment Configuration (Vite)
# =============================================================================

# Backend Server & Realtime Socket URL
# - Development: Leave blank to utilize local Vite dev proxy to localhost:3001
# - Production (e.g. Netlify / Vercel): Set to your deployed backend service URL
#   Example: VITE_BACKEND_URL=https://instachat-hcs.onrender.com
VITE_BACKEND_URL=

# Firebase Web & Firestore Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=battlechat-5329e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=battlechat-5329e
VITE_FIREBASE_STORAGE_BUCKET=battlechat-5329e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=800187924567
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Cloudinary Unsigned Upload Configuration
# Register at https://cloudinary.com and configure an unsigned upload preset
# at Settings -> Upload -> Upload presets (e.g., 'instachat_media')
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# Optional: Custom WebRTC TURN/STUN Configuration
# (If left empty, INSTAChat defaults to community multi-STUN and OpenRelay TURN servers)
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional: Supabase Database Configuration
# (Required only if directly connecting to Supabase client-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Developer Profile Info
VITE_DEVELOPER_NAME=Arjan
VITE_DEVELOPER_PORTFOLIO=https://arjanahmad.website/
