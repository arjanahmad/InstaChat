# INSTAChat Web Environment Variables Template

# Realtime Backend / Supabase Configuration
# For local development with integrated Realtime server, leave VITE_BACKEND_URL blank
# For separate deployed server (e.g. Render / Railway / Fly.io): VITE_BACKEND_URL=https://your-api.com
VITE_BACKEND_URL=

# Supabase Production PostgreSQL & Realtime (Optional / Alternative backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudinary Unsigned Upload Credentials
VITE_CLOUDINARY_CLOUD_NAME=jdkg4l75
VITE_CLOUDINARY_UPLOAD_PRESET=battlechat_upload

# Developer Info
VITE_DEVELOPER_NAME=Arjan
VITE_DEVELOPER_PORTFOLIO=https://arjanahmad.website/
